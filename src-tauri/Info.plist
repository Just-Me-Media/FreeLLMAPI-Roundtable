<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Shown by macOS the first time the Speak button is used. Merged into the
       generated bundle Info.plist by the Tauri bundler. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>Roundtable uses the microphone only when you press Speak, to turn your speech into text.</string>
  <key>NSSpeechRecognitionUsageDescription</key>
  <string>Roundtable turns your dictated speech into text when you press Speak.</string>
</dict>
</plist>
