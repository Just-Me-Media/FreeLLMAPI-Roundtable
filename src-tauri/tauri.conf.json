{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Roundtable",
  "version": "0.2.0",
  "identifier": "media.justme.roundtable",
  "build": {
    "beforeBuildCommand": "mkdir -p dist && cp index.html dist/",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Roundtable",
        "width": 1100,
        "height": 780,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/justme-media/roundtable/releases/download/v{tag}/updates.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQyQjBGMTM3MEYxRjRDOUQKUldTZFRCOFBOL0d3MHVxOU00OVEvYkFKTXk2NGZCSERSNnBEc0tBV29DM0MyeVR1WjJZQnp6NUQK"
    }
  },
  "bundle": {
    "active": true,
    "resources": [
      "../server.js"
    ],
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist",
      "dmg": {
        "windowSize": { "width": 600, "height": 380 },
        "appPosition": { "x": 160, "y": 180 },
        "applicationFolderPosition": { "x": 440, "y": 180 }
      }
    }
  }
}
