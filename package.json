{
  "name": "freellmapi-roundtable",
  "version": "0.2.0",
  "description": "Bring local, cloud, and FreeLLMAPI models into one role-based shared conversation.",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "node server.js",
    "build:mac": "RUSTC_WRAPPER='' cargo tauri build --bundles app",
    "build:dmg": "./scripts/build-and-notarize.sh",
    "build:windows": "powershell -ExecutionPolicy Bypass -File .\\build-windows.ps1",
    "test": "node test/e2e.js",
    "smoke": "node test/smoke.js",
    "screenshots": "node test/screenshots.js",
    "verify": "bash scripts/verify-install.sh",
    "build:install": "RUSTC_WRAPPER='' cargo tauri build --bundles app && bash scripts/install-app.sh",
    "manifest": "node scripts/updates-manifest.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "jsdom": "^31.0.1",
    "mocha": "^12.0.3",
    "playwright": "^1.49.0"
  }
}
